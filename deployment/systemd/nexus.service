[Service]
Type=simple
User=nexus
Group=nexus
WorkingDirectory=/home/nexus/Living-Breathing-Artificial-Intelligence

# Genesis - REAL HASH anchored 18Aug2026 - 9c6b4b1
ExecStart=/home/nexus/Living-Breathing-Artificial-Intelligence/target/release/nexus-core --node --genesis-hash 06980c31ac8e0d841b4e4b6f60565903065bb6f24f3eb352fb7f384dc955207b --constitution v1.3 --article4-locked --evidence-first --audit-log --reputation-threshold 75.0 --heartbeat-pool

Restart=always
RestartSec=10
RestartSec=10
StartLimitInterval=300
StartLimitBurst=5

