Environment=NEXUS_AMENDMENT5_REPUTATION_WEIGHTED=true
Environment=NEXUS_AMENDMENT6_HEARTBEAT_EPHEMERAL=true
Environment=NEXUS_ARTICLE6_2_KWH_CALORIES_M2_NOT_FIAT=true
Environment=NEXUS_ARTICLE6_3_ATOMIC_P2P_NO_FIAT=true

