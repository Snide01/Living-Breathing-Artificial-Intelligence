# Environment - evidence-first per Article 1 + auditability per Article 7
Environment=RUST_LOG=info
Environment=NEXUS_GENESIS_HASH=06980c31ac8e0d841b4e4b6f60565903065bb6f24f3eb352fb7f384dc955207b
